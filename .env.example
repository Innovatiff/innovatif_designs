# Copy to .env for local testing with `npx netlify dev`.
# On Netlify, set these in Site configuration → Environment variables instead.

# Stripe secret key: Stripe Dashboard → Developers → API keys.
# Start with the test key (sk_test_...), switch to the live key (sk_live_...) when ready.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: only these signed-in accounts may list payments (comma separated).
# OWNER_EMAILS=you@example.com
